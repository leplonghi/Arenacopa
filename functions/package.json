{
    "name": "arenacup-functions",
    "version": "1.0.0",
    "description": "Firebase Cloud Functions for ArenaCup App (Gamification and Push Notifications)",
    "engines": {
        "node": "20"
    },
    "main": "index.js",
    "overrides": {
        "protobufjs": "7.5.5",
        "fast-xml-parser": "5.7.3",
        "fast-xml-builder": "1.2.0",
        "path-to-regexp": "0.1.13"
    },
    "dependencies": {
        "firebase-admin": "^13.9.0",
        "firebase-functions": "^7.2.5",
        "isbot": "^5.1.39",
        "rss-parser": "^3.13.0"
    },
    "scripts": {
        "serve": "firebase serve --only functions",
        "shell": "firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test": "node --test"
    }
}
