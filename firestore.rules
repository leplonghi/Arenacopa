rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isBolaoMember(bolaoId) {
      let memberPath = /databases/$(database)/documents/bolao_members/$(request.auth.uid + '_' + bolaoId);
      // [BUG-004 FIX] Require explicit membership_status == "active".
      // Legacy documents without the field are treated as inactive (deny by default).
      // If this breaks legacy data, run a migration to backfill membership_status = "active"
      // on all existing bolao_members documents before deploying these rules.
      return exists(memberPath) &&
        get(memberPath).data.membership_status == "active";
    }

    function isBolaoMemberAfter(bolaoId) {
      let memberPath = /databases/$(database)/documents/bolao_members/$(request.auth.uid + '_' + bolaoId);
      // [BUG-004 FIX] Same explicit check as isBolaoMember — require active status.
      return existsAfter(memberPath) &&
        getAfter(memberPath).data.membership_status == "active";
    }

    function isBolaoCreator(bolaoId) {
      return get(/databases/$(database)/documents/boloes/$(bolaoId)).data.creator_id == request.auth.uid;
    }

    function isBolaoCreatorAfter(bolaoId) {
      return existsAfter(/databases/$(database)/documents/boloes/$(bolaoId)) &&
        getAfter(/databases/$(database)/documents/boloes/$(bolaoId)).data.creator_id == request.auth.uid;
    }

    function getBolao(bolaoId) {
      return get(/databases/$(database)/documents/boloes/$(bolaoId)).data;
    }

    function isOpenBolaoMarket(marketId) {
      let marketPath = /databases/$(database)/documents/bolao_markets/$(marketId);
      return exists(marketPath) &&
        get(marketPath).data.status == "open" &&
        (
          get(marketPath).data.scope != "match" ||
          ("closes_at_ts" in get(marketPath).data && get(marketPath).data.closes_at_ts > request.time)
        );
    }

    function isMatchOpenAndUnstarted(matchId) {
      let matchPath = /databases/$(database)/documents/matches/$(matchId);
      return exists(matchPath) && !(get(matchPath).data.status in ['IN_PLAY', 'FINISHED', 'PAUSED']);
    }

    function isOpenBolaoMatch(bolaoId, matchId) {
      // [BUG-010 FIX] The original assumed a rigid ID pattern (bolaoId_slug_matchId).
      // We now check both the canonical exact_score and match_winner patterns.
      // If the backend uses a different scheme, this is the single place to update.
      // Fallback to checking the matches collection directly for standard bolões without markets.
      return isOpenBolaoMarket(bolaoId + "_exact_score_" + matchId) ||
        isOpenBolaoMarket(bolaoId + "_match_winner_" + matchId) ||
        isOpenBolaoMarket(bolaoId + "_" + matchId) ||
        isMatchOpenAndUnstarted(matchId);
    }

    function canSelfJoinBolao(bolaoId) {
      let bolao = getBolao(bolaoId);
      return bolao.status in ['open', 'active'] && (
        bolao.category == 'public' ||
        (
          request.resource.data.invite_code is string &&
          request.resource.data.invite_code == bolao.invite_code
        )
      );
    }

    function isGrupoMember(grupoId) {
      let memberPath = /databases/$(database)/documents/grupo_members/$(request.auth.uid + '_' + grupoId);
      // [BUG-004 FIX parity] Same explicit active-only check applied to grupo membership.
      return exists(memberPath) &&
        get(memberPath).data.membership_status == "active";
    }

    function isGrupoCreator(grupoId) {
      return get(/databases/$(database)/documents/grupos/$(grupoId)).data.creator_id == request.auth.uid;
    }

    function isGrupoCreatorAfter(grupoId) {
      return existsAfter(/databases/$(database)/documents/grupos/$(grupoId)) &&
        getAfter(/databases/$(database)/documents/grupos/$(grupoId)).data.creator_id == request.auth.uid;
    }

    function canReadGrupo(grupoId) {
      return resource.data.visibility == "public" ||
        resource.data.category == "public" ||
        isGrupoCreator(grupoId) ||
        isGrupoMember(grupoId);
    }

    function getGrupo(grupoId) {
      return get(/databases/$(database)/documents/grupos/$(grupoId)).data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).changedKeys();
    }

    function isPresentationOnlyBolaoUpdate() {
      return changedKeys().hasOnly([
        "name",
        "description",
        "avatar_url",
        "invite_message",
        "updated_at",
        "audit_meta",
        "allowed_match_ids"
      ]);
    }

    function canSelfJoinGrupo(grupoId) {
      let grupo = getGrupo(grupoId);
      return grupo.category == 'public' ||
        (
          request.resource.data.invite_code is string &&
          request.resource.data.invite_code == grupo.invite_code
        );
    }

    // profiles
    match /profiles/{userId} {
      allow read: if isSignedIn() && isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // public_profiles — sanitized public identity only
    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        isOwner(userId) &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'user_id',
          'name',
          'nickname',
          'avatar_url',
          'created_at',
          'updated_at'
        ]);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // matches — public read, only Firebase Admin SDK can write
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // copa_news — public read, only Firebase Admin SDK can write
    match /copa_news/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    // news — championship feeds, public read
    match /news/{newsId} {
      allow read: if true;
      allow write: if false;
    }

    // news_sources — public catalog, only Admin SDK writes
    match /news_sources/{sourceId} {
      allow read: if true;
      allow write: if false;
    }

    // news_articles — normalized news feed for app
    match /news_articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    // news_links_by_championship — aggregated links by championship
    match /news_links_by_championship/{championshipId} {
      allow read: if true;
      allow write: if false;
    }

    // news_fetch_runs / news_raw — server-only operational collections
    match /news_fetch_runs/{runId} {
      allow read, write: if false;
    }

    match /news_raw/{rawId} {
      allow read, write: if false;
    }

    // standings — public read, only Admin SDK writes
    match /standings/{standingId} {
      allow read: if true;
      allow write: if false;
    }

    // teams — public read, only Admin SDK writes
    match /teams/{teamId} {
      allow read: if true;
      allow write: if false;
    }

    // boloes
    match /boloes/{bolaoId} {
      allow read: if isSignedIn() && (
        resource.data.category == 'public' ||
        isBolaoMember(bolaoId) ||
        isOwner(resource.data.creator_id) ||
        // Allow list queries where creator_id == auth.uid (used by useProfileStats)
        request.auth.uid != null
      );
      // Server-owned create path. Client creation goes through Cloud Functions
      // so launch limits and related member/market writes are enforced together.
      allow create: if false;
      allow update: if isSignedIn() &&
        isOwner(resource.data.creator_id) &&
        isPresentationOnlyBolaoUpdate();
      allow delete: if isSignedIn() && isOwner(resource.data.creator_id);
    }

    // bolao_members
    match /bolao_members/{memberId} {
      allow get: if isSignedIn() && (
        isOwner(resource.data.user_id) ||
        isBolaoMember(resource.data.bolao_id)
      );
      // [BUG-015 FIX] resource.data is null in list context, so allow list
      // for any signed-in user. Security by convention: all queries MUST
      // scope to where("user_id", "==", request.auth.uid) on the client.
      // Never list bolao_members without a user-scoped filter.
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.user_id) &&
        request.resource.data.role == 'admin' &&
        (
          isBolaoCreator(request.resource.data.bolao_id) ||
          isBolaoCreatorAfter(request.resource.data.bolao_id)
        );
      allow update: if false;
      allow delete: if false;
    }

    match /bolao_join_requests/{requestId} {
      // get: document-level access for requester or bolão creator
      allow get: if isSignedIn() && (
        isOwner(resource.data.user_id) ||
        isBolaoCreator(resource.data.bolao_id)
      );
      // [BUG-012] list: resource is null in list context, so we require auth only.
      // ⚠️ SECURITY-BY-CONVENTION: This rule only works safely because ALL queries
      // in the frontend MUST scope to where("user_id", "==", request.auth.uid) OR
      // where("bolao_id", "==", <bolaoId where user is creator>).
      // Never list join_requests without a user-scoped filter.
      allow list: if isSignedIn();
      allow create, update, delete: if false;
    }

    // commercial campaign governance — server-owned, with public read only for published campaign pages
    match /merchants/{merchantId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /merchant_staff/{staffId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /commercial_campaigns/{campaignId} {
      allow read: if resource.data.status in ["published", "live", "finished"] ||
        (
          isSignedIn() &&
          exists(/databases/$(database)/documents/merchant_staff/$(resource.data.merchant_id + "_" + request.auth.uid))
        );
      allow create, update, delete: if false;
    }

    match /commercial_orders/{orderId} {
      allow read: if isSignedIn() &&
        exists(/databases/$(database)/documents/merchant_staff/$(resource.data.merchant_id + "_" + request.auth.uid));
      allow create, update, delete: if false;
    }

    match /commercial_audit/{auditId} {
      allow read, write: if false;
    }

    // bolao_markets
    match /bolao_markets/{marketId} {
      allow read: if isSignedIn() && (
        isBolaoMember(resource.data.bolao_id) ||
        isBolaoCreator(resource.data.bolao_id)
      );
      allow create: if false;
      allow update, delete: if isSignedIn() && isBolaoCreator(resource.data.bolao_id);
    }

    // bolao_activity — generated by backend, readable by participants
    match /bolao_activity/{activityId} {
      allow read: if isSignedIn() && (
        isBolaoMember(resource.data.bolao_id) ||
        isBolaoCreator(resource.data.bolao_id)
      );
      allow write: if false;
    }

    // bolao_extra_bets — legacy mirror for tournament-wide extras
    match /bolao_extra_bets/{extraId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.user_id) ||
        isBolaoCreator(resource.data.bolao_id)
      );
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.user_id) &&
        request.resource.data.user_id == request.auth.uid &&
        isBolaoMember(request.resource.data.bolao_id);
      // [BUG-013 FIX] update now also guards that the match is still open,
      // preventing retroactive bet changes after the match has started.
      allow update: if isSignedIn() &&
        isOwner(resource.data.user_id) &&
        isOpenBolaoMatch(resource.data.bolao_id, resource.data.match_id) &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.bolao_id == resource.data.bolao_id &&
        request.resource.data.category == resource.data.category;
      allow delete: if isSignedIn() && (
        isOwner(resource.data.user_id) ||
        isBolaoCreator(resource.data.bolao_id)
      );
    }

    // bolao_palpites
    match /bolao_palpites/{palpiteId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.user_id) ||
        isBolaoMember(resource.data.bolao_id)
      );
      // SECURITY NOTE: list queries are open to any signed-in user because
      // resource.data is null in list context. Real security is enforced
      // client-side by always scoping queries to where("user_id", "==", auth.uid)
      // AND where("bolao_id", "==", bolaoId). Never list without both filters.
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.user_id) &&
        isBolaoMember(request.resource.data.bolao_id) &&
        palpiteId == request.auth.uid + "_" + request.resource.data.bolao_id + "_" + request.resource.data.match_id &&
        isOpenBolaoMatch(request.resource.data.bolao_id, request.resource.data.match_id) &&
        request.resource.data.points == null &&
        request.resource.data.user_id == request.auth.uid;
      // [BUG-005 FIX] update now enforces that the match is still open,
      // preventing post-kickoff score changes even when points is still null.
      allow update: if isSignedIn() &&
        isOwner(resource.data.user_id) &&
        resource.data.points == null &&
        isOpenBolaoMatch(resource.data.bolao_id, resource.data.match_id) &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.bolao_id == resource.data.bolao_id &&
        request.resource.data.match_id == resource.data.match_id &&
        request.resource.data.points == resource.data.points;
      allow delete: if false;
    }

    // bolao_exclusive_score_locks — server-owned seat occupancy for exclusive-score pools
    match /bolao_exclusive_score_locks/{lockId} {
      allow read: if isSignedIn() && (
        isBolaoMember(resource.data.bolao_id) ||
        isBolaoCreator(resource.data.bolao_id)
      );
      allow write: if false;
    }

    // bolao_predictions
    match /bolao_predictions/{predictionId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.user_id) ||
        isBolaoMember(resource.data.bolao_id)
      );
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.user_id) &&
        isBolaoMember(request.resource.data.bolao_id) &&
        isOpenBolaoMarket(request.resource.data.market_id) &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.points_awarded == null &&
        request.resource.data.resolved == false;
      // [BUG-001 FIX] update now checks membership explicitly (prevents former
      // members from updating) and accepts the market as open if EITHER the
      // stored market_id OR the incoming one passes isOpenBolaoMarket — this
      // tolerates the timestamp propagation race near market close time.
      allow update: if isSignedIn() &&
        isOwner(resource.data.user_id) &&
        isBolaoMember(resource.data.bolao_id) &&
        (!("resolved" in resource.data) || resource.data.resolved == false) &&
        (
          isOpenBolaoMarket(resource.data.market_id) ||
          isOpenBolaoMarket(request.resource.data.market_id)
        ) &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.bolao_id == resource.data.bolao_id &&
        request.resource.data.market_id == resource.data.market_id &&
        request.resource.data.points_awarded == resource.data.points_awarded &&
        request.resource.data.resolved == resource.data.resolved;
      allow delete: if isSignedIn() && isOwner(resource.data.user_id);
    }

    // bolao_champion_predictions
    match /bolao_champion_predictions/{predId} {
      allow get: if isSignedIn() && (
        predId.matches(request.auth.uid + "_.*") ||
        isOwner(resource.data.user_id) ||
        isBolaoMember(resource.data.bolao_id)
      );
      // [BUG-006 FIX] resource.data is null in list context — the previous rule
      // always evaluated to false (silently denying all list queries for members).
      // Security for list is enforced client-side by scoping to the user's own
      // documents (where bolao_id matches a bolão the user belongs to).
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        isOwner(request.resource.data.user_id) &&
        (
          isBolaoMember(request.resource.data.bolao_id) ||
          isBolaoMemberAfter(request.resource.data.bolao_id) ||
          isBolaoCreatorAfter(request.resource.data.bolao_id)
        ) &&
        request.resource.data.user_id == request.auth.uid;
      allow delete: if isSignedIn() && isOwner(resource.data.user_id);
    }

    // bolao_rankings — only Admin SDK writes
    match /bolao_rankings/{rankingId} {
      allow get: if isSignedIn() && isBolaoMember(resource.data.bolao_id);
      // [BUG-014] list is intentionally more permissive than get to support
      // useProfileStats (fetches user's own rankings across all bolões without
      // being a current member). Security relies on client always scoping to
      // where("user_id", "==", request.auth.uid) — never list all rankings.
      allow list: if isSignedIn();
      allow write: if false;
    }

    // bolao_onboarding_state
    match /bolao_onboarding_state/{stateId} {
      allow create: if isSignedIn() && isOwner(request.resource.data.user_id);
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.user_id);
    }

    // notifications
    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && isOwner(resource.data.user_id);
      allow create: if false;
      allow delete: if isSignedIn() && isOwner(resource.data.user_id);
    }

    // push_subscriptions
    match /push_subscriptions/{subId} {
      allow create: if isSignedIn() && isOwner(request.resource.data.user_id);
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.user_id);
    }

    // native_push_tokens
    match /native_push_tokens/{tokenId} {
      allow create: if isSignedIn() && isOwner(request.resource.data.user_id);
      allow read, update, delete: if isSignedIn() && isOwner(resource.data.user_id);
    }

    // premium_subscriptions — only Admin SDK writes
    match /premium_subscriptions/{subId} {
      allow read: if isSignedIn() && subId == request.auth.uid && isOwner(resource.data.user_id);
      allow write: if false;
    }

    match /premium_subscription_sessions/{sessionId} {
      allow read, write: if false;
    }

    // grupos
    match /grupos/{grupoId} {
      allow read: if isSignedIn() && canReadGrupo(grupoId);
      allow create: if isSignedIn() && isOwner(request.resource.data.creator_id);
      allow update, delete: if false;
    }

    // grupo_members
    match /grupo_members/{memberId} {
      allow get: if isSignedIn() && (
        isOwner(resource.data.user_id) ||
        isGrupoMember(resource.data.grupo_id) ||
        isGrupoCreator(resource.data.grupo_id)
      );
      // [BUG-015 FIX parity] Same list fix as bolao_members.
      // All list queries must scope to where("user_id", "==", auth.uid).
      allow list: if isSignedIn();
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.user_id) &&
        request.resource.data.role == 'admin' &&
        (
          isGrupoCreator(request.resource.data.grupo_id) ||
          isGrupoCreatorAfter(request.resource.data.grupo_id)
        );
      allow update, delete: if false;
    }

    match /grupo_join_requests/{requestId} {
      // get: document-level access for requester, grupo members, or creator
      allow get: if isSignedIn() && (
        isOwner(resource.data.user_id) ||
        isGrupoMember(resource.data.grupo_id) ||
        isGrupoCreator(resource.data.grupo_id)
      );
      // list: used by pending join request hooks (queries creator_id == uid)
      allow list: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /group_audit/{auditId} {
      allow read, write: if false;
    }

    match /bolao_audit/{auditId} {
      allow read, write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
