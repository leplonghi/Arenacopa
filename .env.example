# Firebase Web config (public — shipped to the browser, safe to commit values).
# REQUIRED AT BUILD TIME. A build without these bakes an empty config and the
# app throws auth/invalid-api-key on load → blank screen. Retrieve real values
# with: firebase apps:sdkconfig WEB
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ENABLE_PREMIUM_SIMULATION=false
VITE_PREMIUM_CHECKOUT_ENABLED=false
VITE_STRIPE_PREMIUM_PRICE_LABEL=R$9,90
VITE_STRIPE_PREMIUM_PRODUCT_NAME=ArenaCUP Premium

# Supabase Edge Functions / local dev
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SITE_URL=http://localhost:8080

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PREMIUM_PRICE_ID=price_xxx
